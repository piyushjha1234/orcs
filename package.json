{
  "name": "orcs",
  "version": "2.0.0",
  "description": "Script-driven harness that delivers a project with four Claude Code agents.",
  "type": "module",
  "bin": {
    "orcs": "src/cli.ts"
  },
  "files": [
    "agents",
    "schemas",
    "config",
    "templates",
    "src",
    "web"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "tsc && tsc -p web && tsc -p test/ui",
    "test": "node --test test/*.test.ts",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
