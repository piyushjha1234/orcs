{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["ask", "done"] },
    "questions": { "type": "array", "maxItems": 3, "items": { "$ref": "question.json" } },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^tc-[0-9]+$" },
          "br": { "type": "string", "pattern": "^br-[0-9]+$" },
          "type": {
            "type": "string",
            "enum": ["functional", "ui", "ux", "accessibility", "responsive", "api", "integration", "e2e", "regression", "performance", "load", "stress", "security", "compatibility", "data_integrity", "error_recovery", "localization"]
          },
          "envs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^env-[0-9]+$" } },
          "title": { "type": "string", "maxLength": 90 },
          "steps": { "type": "array", "items": { "type": "string" } },
          "expected": { "type": "string" },
          "auto": { "type": "boolean", "description": "true when a runnable test in tests_dir covers this case." }
        },
        "required": ["id", "br", "type", "envs", "title", "steps", "expected", "auto"]
      }
    },
    "files": { "type": "array", "items": { "type": "string" }, "description": "Test files written, all inside tests_dir." }
  },
  "required": ["status"]
}
