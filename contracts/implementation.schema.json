{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orcs Implementation Contract",
  "type": "object",
  "required": ["task_id", "files_changed", "requirements_implemented", "dependencies_added", "known_limitations", "blocker"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^DEV-[0-9]+$"},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "requirements_implemented": {"type": "array", "items": {"type": "string", "pattern": "^BR-[0-9]+$"}},
    "dependencies_added": {"type": "array", "items": {"type": "string"}},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "blocker": {"type": ["string", "null"]}
  }
}
