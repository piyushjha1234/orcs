{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orcs Architecture Contract",
  "type": "object",
  "required": ["task_id", "approach", "components", "requirement_mapping", "new_dependencies", "alternatives_considered", "implementation_steps", "open_questions", "microtasks"],
  "properties": {
    "task_id": {"type": "string"},
    "approach": {"type": "string", "minLength": 1},
    "components": {"type": "array", "items": {"type": "string"}},
    "requirement_mapping": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "new_dependencies": {"type": "array", "items": {"type": "object", "required": ["name", "justification"], "properties": {"name": {"type": "string"}, "justification": {"type": "string", "minLength": 1}}}},
    "alternatives_considered": {"type": "array"},
    "implementation_steps": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "microtasks": {"type": "array", "minItems": 1, "items": {"$ref": "microtask.schema.json"}}
  }
}
