{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orcs Micro-task Contract",
  "type": "object",
  "required": ["task_id", "parent_task", "objective", "requirements", "dependencies", "allowed_files", "expected_outputs", "acceptance_criteria", "constraints", "complexity", "budget", "status"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^DEV-[0-9]+$"},
    "parent_task": {"type": "string"},
    "objective": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^BR-[0-9]+$"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "allowed_files": {"type": "array", "items": {"type": "string"}},
    "expected_outputs": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "complexity": {"enum": ["low", "medium", "high"]},
    "budget": {"type": "object", "required": ["max_iterations"], "properties": {"max_iterations": {"type": "integer", "minimum": 1}}},
    "status": {"enum": ["pending", "in_progress", "done", "blocked"]}
  }
}
